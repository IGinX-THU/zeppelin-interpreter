<style>
    #udf-result {
        display: block;
        width: 100%;
    }

    #prompt-text {
        font-size: 0.7em;
        color: #555555;
        white-space: pre-wrap;
        background: initial;
        border: initial;
    }

    #udf-pre {
        font-size: 0.7em;
    }

    details summary {
        display: list-item;
        cursor: pointer;
    }
</style>

<div id="udf-result">
    <details id="prompt-content">
        <summary id="prompt-title">Prompt</summary>
        <pre id="prompt-text">${prompt}</pre>
    </details>
    <pre id="udf-pre"><code class="language-python">${python_text}</code></pre>
</div>

<script>
    function loadCSS(href) {
        return new Promise((resolve, reject) => {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            link.onload = resolve;
            link.onerror = reject;
            document.head.appendChild(link);
        });
    }
    (async function () {
        await import('https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js');
        await import('https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js');
        await loadCSS('https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css');
    })();
</script>