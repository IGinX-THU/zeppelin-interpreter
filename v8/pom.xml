<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.edu.tsinghua</groupId>
        <artifactId>zeppelin-iginx</artifactId>
        <version>0.7.2</version>
    </parent>

    <artifactId>zeppelin8-iginx</artifactId>
    <packaging>jar</packaging>

    <properties>
        <skipTests>true</skipTests>
        <js.lib.dir>${project.basedir}/src/main/resources/static/lib</js.lib.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.zeppelin</groupId>
            <artifactId>zeppelin-interpreter</artifactId>
            <version>0.8.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cn.edu.tsinghua</groupId>
            <artifactId>iginx-session</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version> <executions>
                    <execution>
                        <id>download-js-libs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Downloading JavaScript libraries to ${js.lib.dir}"/>

                                <mkdir dir="${js.lib.dir}"/>

                                <get src="https://code.highcharts.com/highcharts.js"
                                     dest="${js.lib.dir}/highcharts.js"
                                     verbose="true" usetimestamp="true"/>

                                <get src="https://code.highcharts.com/modules/treemap.js"
                                     dest="${js.lib.dir}/treemap.js"
                                     verbose="true" usetimestamp="true"/>

                                <get src="https://code.highcharts.com/modules/treegraph.js"
                                     dest="${js.lib.dir}/treegraph.js"
                                     verbose="true" usetimestamp="true"/>

                                <get src="https://code.highcharts.com/modules/accessibility.js"
                                     dest="${js.lib.dir}/accessibility.js"
                                     verbose="true" usetimestamp="true"/>

                                <echo message="JavaScript libraries downloaded."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>v8</id>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>org.apache.zeppelin.iginx.IginxInterpreter8</pattern>
                                    <shadedPattern>org.apache.zeppelin.iginx.IginxInterpreter</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>
